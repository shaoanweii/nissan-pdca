{
  "name": "insights",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "build:dev": "run-p type-check && vite build --mode build_dev && node ./build/build.js",
    "build:test": "run-p type-check && vite build --mode build_test && node ./build/build.js",
    "build:rc": "run-p type-check && vite build --mode build_rc && node ./build/build.js",
    "postbuild": "node ./build/build.js",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix"
  },
  "dependencies": {
    "amfe-flexible": "^2.2.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "echarts-liquidfill": "^3.1.0",
    "fast-glob": "^3.3.2",
    "html2canvas": "^1.4.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "pinia": "^2.2.4",
    "remixicon": "^4.6.0",
    "vue": "^3.5.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.54.5",
    "@arco-plugins/vite-vue": "^1.4.5",
    "@tsconfig/node20": "^20.1.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.10",
    "@types/postcss-pxtorem": "^6.1.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.9.0",
    "less": "^4.2.0",
    "npm-run-all2": "^6.1.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^2.8.8",
    "sass": "1.71.0",
    "sass-loader": "^16.0.2",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.11",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.3.7",
    "vue-tsc": "^1.8.27"
  }
}
